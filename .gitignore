# Environment variables - IMPORTANT!
# Never commit your secrets.
.env

# Go build artifacts and binaries
# -----------------
# Compiled executables
*.exe
*.exe~
*.dll
*.so
*.dylib

# The compiled server binary (go build -o server ./cmd/server).
# Anchored to the backend folder so it does not also hide backend/cmd/server/.
/backend/server

# Test coverage files
*.out
coverage.txt

# Dependency directories (though 'go mod' makes this less common)
/vendor/

# IDE and editor files
# -----------------
# VS Code
.vscode/

# JetBrains (GoLand)
.idea/

# System files
# -----------------
# macOS
.DS_Store

# Windows
Thumbs.db